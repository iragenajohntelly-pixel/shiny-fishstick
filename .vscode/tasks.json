{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Vite development server",
			"type": "shell",
			"command": "npm.cmd",
			"options": {
				"env": {
					"PATH": "C:\\Program Files\\nodejs;${env:PATH}"
				}
			},
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^(.*(?:ERROR|Error|error).*)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*$",
					"endsPattern": ".*Local:"
				}
			}
		}
	]
}